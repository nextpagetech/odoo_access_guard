<odoo>
    <data>
        <record id="view_access_guard_management_tree_templates_inherit" model="ir.ui.view">
            <field name="name">access.guard.management.tree.templates.inherit</field>
            <field name="model">access.guard.management</field>
            <field name="inherit_id" ref="npt_access_guard.view_access_guard_management_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="after">
                    <field name="category" optional="show"/>
                    <field name="template_id" optional="hide"/>
                </xpath>
                <xpath expr="//field[@name='rule_count']" position="after">
                    <field name="conflict_count" optional="show"/>
                </xpath>
            </field>
        </record>

        <record id="view_access_guard_management_form_templates_inherit" model="ir.ui.view">
            <field name="name">access.guard.management.form.templates.inherit</field>
            <field name="model">access.guard.management</field>
            <field name="inherit_id" ref="npt_access_guard.view_access_guard_management_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_preview_access"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-search">
                        <field name="conflict_count" widget="statinfo" string="Warnings"/>
                    </button>
                    <button name="action_create_template"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-copy">
                        <span class="o_stat_text">Save as Template</span>
                    </button>
                </xpath>
                <xpath expr="//field[@name='name']" position="after">
                    <field name="category"/>
                    <field name="template_id" readonly="1"/>
                </xpath>
                <xpath expr="//field[@name='read_only']" position="attributes">
                    <attribute name="string">Read-Only Target Models</attribute>
                    <attribute name="help">When enabled, Access Guard blocks create, edit, and delete on the models configured inside this rule.</attribute>
                </xpath>
            </field>
        </record>

        <record id="view_access_guard_template_tree" model="ir.ui.view">
            <field name="name">access.guard.template.tree</field>
            <field name="model">access.guard.template</field>
            <field name="arch" type="xml">
                <list string="Access Templates">
                    <field name="name"/>
                    <field name="template_code"/>
                    <field name="template_version" optional="show"/>
                    <field name="source_type" string="Origin" optional="show"/>
                    <field name="category"/>
                    <field name="portability_status" optional="show"/>
                    <field name="assigned_rule_count" optional="show"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="view_access_guard_template_form" model="ir.ui.view">
            <field name="name">access.guard.template.form</field>
            <field name="model">access.guard.template</field>
            <field name="arch" type="xml">
                <form string="Access Template">
                    <header>
                        <button name="action_apply_template" string="Apply Template" type="object" class="btn-primary"/>
                        <button name="action_export_template" string="Export Template" type="object" class="btn-secondary" groups="npt_access_guard.group_access_guard_manager"/>
                        <button name="action_refresh_snapshot" string="Refresh Snapshot" type="object" class="btn-secondary" invisible="source_type != 'local_rule'"/>
                        <button name="action_open_source_rule" string="Open Source Rule" type="object" class="btn-secondary" invisible="source_type != 'local_rule'"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_open_assigned_rules" type="object" class="oe_stat_button" icon="fa-shield">
                                <field name="assigned_rule_count" widget="statinfo" string="Assigned Rules"/>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="template_code"/>
                                <field name="template_version"/>
                                <field name="category"/>
                                <field name="source_type" string="Origin" readonly="1"/>
                                <field name="active"/>
                            </group>
                            <group>
                                <field name="source_management_id" options="{'no_create': True}" required="source_type == 'local_rule'" invisible="source_type == 'imported'"/>
                                <field name="portability_status" readonly="1"/>
                                <field name="resolution_status" readonly="1" invisible="source_type != 'imported'"/>
                                <field name="imported_at" readonly="1" invisible="source_type != 'imported'"/>
                                <field name="imported_filename" readonly="1" invisible="source_type != 'imported'"/>
                            </group>
                        </group>
                        <group>
                            <field name="description" placeholder="Notes for admins who apply this template."/>
                        </group>
                        <notebook>
                            <page string="Details">
                                <group>
                                    <group>
                                        <field name="rule_summary" readonly="1" invisible="source_type != 'local_rule'"/>
                                        <field name="schema_version" readonly="1"/>
                                        <field name="source_module_version" readonly="1"/>
                                        <field name="snapshot_date" readonly="1" invisible="source_type != 'local_rule'"/>
                                        <field name="snapshot_valid" readonly="1" invisible="source_type != 'local_rule'"/>
                                        <field name="imported_access_guard_version" readonly="1" invisible="source_type != 'imported'"/>
                                        <field name="import_format_version" readonly="1" invisible="source_type != 'imported'"/>
                                    </group>
                                    <group>
                                        <field name="snapshot_hash" readonly="1" invisible="source_type != 'local_rule'"/>
                                        <field name="portable_hash" readonly="1"/>
                                        <field name="portable_valid" readonly="1"/>
                                        <field name="resolution_date" readonly="1" invisible="source_type != 'imported'"/>
                                        <field name="resolution_hash" readonly="1" invisible="source_type != 'imported'"/>
                                    </group>
                                </group>
                                <group string="Frozen Snapshot Summary" invisible="source_type != 'local_rule'">
                                    <field name="snapshot_summary" readonly="1" nolabel="1"/>
                                </group>
                            </page>
                            <page string="Technical" groups="npt_access_guard.group_access_guard_manager">
                                <div class="d-flex flex-wrap gap-2">
                                    <button name="action_view_snapshot" string="View Snapshot" type="object" class="btn-secondary" invisible="source_type != 'local_rule'"/>
                                    <button name="action_view_portable_payload" string="View Portable Payload" type="object" class="btn-secondary"/>
                                    <button name="action_view_portability_report" string="View Portability Report" type="object" class="btn-secondary"/>
                                    <button name="action_view_resolution" string="View Resolution" type="object" class="btn-secondary" invisible="source_type != 'imported'"/>
                                </div>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_access_guard_template_resolution" model="ir.ui.view">
            <field name="name">access.guard.template.resolution.form</field>
            <field name="model">access.guard.template</field>
            <field name="arch" type="xml">
                <form string="Target Resolution" create="0" edit="0" delete="0">
                    <sheet>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="template_code" readonly="1"/>
                            <field name="template_version" readonly="1"/>
                            <field name="resolution_status" readonly="1"/>
                            <field name="resolution_date" readonly="1"/>
                            <field name="resolution_hash" readonly="1"/>
                        </group>
                        <field name="resolution_payload" readonly="1" nolabel="1"/>
                    </sheet>
                    <footer>
                        <button string="Close" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="view_access_guard_template_snapshot" model="ir.ui.view">
            <field name="name">access.guard.template.snapshot.form</field>
            <field name="model">access.guard.template</field>
            <field name="arch" type="xml">
                <form string="Template Snapshot" create="0" edit="0" delete="0">
                    <sheet>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="template_code" readonly="1"/>
                            <field name="template_version" readonly="1"/>
                            <field name="schema_version" readonly="1"/>
                            <field name="snapshot_date" readonly="1"/>
                            <field name="snapshot_hash" readonly="1"/>
                        </group>
                        <field name="snapshot_payload" readonly="1" nolabel="1"/>
                    </sheet>
                    <footer>
                        <button string="Close" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="view_access_guard_template_portable" model="ir.ui.view">
            <field name="name">access.guard.template.portable.form</field>
            <field name="model">access.guard.template</field>
            <field name="arch" type="xml">
                <form string="Portable Template Payload" create="0" edit="0" delete="0">
                    <sheet>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="template_code" readonly="1"/>
                            <field name="template_version" readonly="1"/>
                            <field name="portability_status" readonly="1"/>
                            <field name="portable_hash" readonly="1"/>
                            <field name="portable_valid" readonly="1"/>
                        </group>
                        <field name="portable_payload" readonly="1" nolabel="1"/>
                    </sheet>
                    <footer>
                        <button string="Close" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="view_access_guard_template_portability_report" model="ir.ui.view">
            <field name="name">access.guard.template.portability.report.form</field>
            <field name="model">access.guard.template</field>
            <field name="arch" type="xml">
                <form string="Template Portability Report" create="0" edit="0" delete="0">
                    <sheet>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="template_code" readonly="1"/>
                            <field name="template_version" readonly="1"/>
                            <field name="portability_status" readonly="1"/>
                            <field name="portable_valid" readonly="1"/>
                        </group>
                        <field name="portability_report" readonly="1" nolabel="1"/>
                    </sheet>
                    <footer>
                        <button string="Close" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="view_access_guard_export_wizard_form" model="ir.ui.view">
            <field name="name">access.guard.export.wizard.form</field>
            <field name="model">access.guard.export.wizard</field>
            <field name="arch" type="xml">
                <form string="Confirm Template Export" create="0" edit="0" delete="0">
                    <group>
                        <field name="template_ids" widget="many2many_tags" options="{'no_create': True}" readonly="1"/>
                        <field name="warning_text" readonly="1" nolabel="1"/>
                    </group>
                    <field name="file_data" filename="filename" invisible="1"/>
                    <field name="filename" invisible="1"/>
                    <footer>
                        <button string="Export Anyway" name="action_export_anyway" type="object" class="btn-primary"/>
                        <button string="Cancel" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_access_guard_export_templates" model="ir.actions.server">
            <field name="name">Export Templates</field>
            <field name="model_id" ref="model_access_guard_template"/>
            <field name="binding_model_id" ref="model_access_guard_template"/>
            <field name="binding_view_types">list</field>
            <field name="groups_id" eval="[(4, ref('npt_access_guard.group_access_guard_manager'))]"/>
            <field name="state">code</field>
            <field name="code">action = records.action_export_templates()</field>
        </record>

        <record id="action_access_guard_template" model="ir.actions.act_window">
            <field name="name">Access Templates</field>
            <field name="res_model">access.guard.template</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'active_test': False}</field>
        </record>

        <record id="view_access_guard_import_wizard_form" model="ir.ui.view">
            <field name="name">access.guard.import.wizard.form</field>
            <field name="model">access.guard.import.wizard</field>
            <field name="arch" type="xml">
                <form string="Import Template" create="0" delete="0">
                    <field name="state" invisible="1"/>
                    <field name="overall_status" invisible="1"/>
                    <field name="detected_format" invisible="1"/>
                    <field name="template_count" invisible="1"/>
                    <field name="imported_count" invisible="1"/>
                    <field name="skipped_count" invisible="1"/>

                    <group invisible="state != 'upload'">
                        <field name="file_data" filename="filename" required="state == 'upload'"/>
                        <field name="filename" invisible="1"/>
                    </group>

                    <group invisible="state in ('upload', 'imported')">
                        <group>
                            <field name="detected_format" readonly="1"/>
                            <field name="template_count" readonly="1"/>
                        </group>
                        <group>
                            <field name="overall_status" readonly="1"/>
                            <field name="filename" readonly="1"/>
                        </group>
                    </group>

                    <group invisible="state != 'imported'">
                        <field name="import_result_summary" readonly="1" nolabel="1"/>
                        <field name="imported_template_ids" widget="many2many_tags" readonly="1" invisible="not imported_template_ids"/>
                        <field name="skipped_template_ids" widget="many2many_tags" readonly="1" invisible="not skipped_template_ids"/>
                    </group>

                    <notebook invisible="state in ('upload', 'imported')">
                        <page string="Validation Summary" invisible="state == 'mapping'">
                            <field name="result_line_ids" nolabel="1" readonly="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="template_code"/>
                                    <field name="template_version"/>
                                    <field name="status"/>
                                    <field name="duplicate_status"/>
                                    <field name="operation"/>
                                </list>
                                <form create="0" edit="0" delete="0">
                                    <group>
                                        <field name="template_code"/>
                                        <field name="template_version"/>
                                        <field name="status"/>
                                        <field name="duplicate_status"/>
                                        <field name="operation"/>
                                    </group>
                                    <field name="summary" nolabel="1"/>
                                </form>
                            </field>
                            <field name="validation_report_html" readonly="1" nolabel="1"/>
                        </page>

                        <page string="Resolve Mappings" invisible="state != 'mapping'">
                            <field name="mapping_line_ids" nolabel="1">
                                <list create="0" delete="0" editable="bottom">
                                    <field name="template_code" readonly="1"/>
                                    <field name="reference_type" readonly="1"/>
                                    <field name="source_label" readonly="1"/>
                                    <field name="message" readonly="1" optional="hide"/>
                                    <field name="target_model" readonly="1" optional="hide"/>
                                    <field name="target_menu_id" invisible="reference_type != 'menu'" options="{'no_create': True}"/>
                                    <field name="target_view_id" invisible="reference_type != 'view'" options="{'no_create': True}"/>
                                    <field name="target_action_id" invisible="reference_type not in ('action', 'report')" options="{'no_create': True}"/>
                                    <field name="target_group_id" invisible="reference_type != 'group'" options="{'no_create': True}"/>
                                    <field name="target_picking_type_id" invisible="reference_type != 'picking_type'" options="{'no_create': True}"/>
                                    <field name="target_ui_element_id" invisible="reference_type != 'ui_element'" options="{'no_create': True}"/>
                                    <field name="target_search_item_id" invisible="reference_type != 'search_item'" options="{'no_create': True}"/>
                                    <field name="target_view_mode_id" invisible="reference_type != 'view_mode'" options="{'no_create': True}"/>
                                    <field name="target_model_id" invisible="reference_type != 'model'" options="{'no_create': True}"/>
                                    <field name="target_field_id" invisible="reference_type != 'field'" options="{'no_create': True}"/>
                                    <field name="target_record_id" invisible="reference_type != 'domain_record'"/>
                                    <field name="target_record_reference" invisible="reference_type != 'domain_record'"/>
                                </list>
                                <form create="0" delete="0">
                                    <group>
                                        <field name="template_code" readonly="1"/>
                                        <field name="reference_type" readonly="1"/>
                                        <field name="source_label" readonly="1"/>
                                        <field name="source_model" readonly="1"/>
                                        <field name="target_model" readonly="1"/>
                                        <field name="status" readonly="1"/>
                                    </group>
                                    <field name="message" readonly="1"/>
                                    <field name="source_payload" readonly="1"/>
                                    <group string="Target">
                                        <field name="target_menu_id" invisible="reference_type != 'menu'" options="{'no_create': True}"/>
                                        <field name="target_view_id" invisible="reference_type != 'view'" options="{'no_create': True}"/>
                                        <field name="target_action_id" invisible="reference_type not in ('action', 'report')" options="{'no_create': True}"/>
                                        <field name="target_group_id" invisible="reference_type != 'group'" options="{'no_create': True}"/>
                                        <field name="target_picking_type_id" invisible="reference_type != 'picking_type'" options="{'no_create': True}"/>
                                        <field name="target_ui_element_id" invisible="reference_type != 'ui_element'" options="{'no_create': True}"/>
                                        <field name="target_search_item_id" invisible="reference_type != 'search_item'" options="{'no_create': True}"/>
                                        <field name="target_view_mode_id" invisible="reference_type != 'view_mode'" options="{'no_create': True}"/>
                                        <field name="target_model_id" invisible="reference_type != 'model'" options="{'no_create': True}"/>
                                        <field name="target_field_id" invisible="reference_type != 'field'" options="{'no_create': True}"/>
                                        <field name="target_record_id" invisible="reference_type != 'domain_record'"/>
                                        <field name="target_record_reference" invisible="reference_type != 'domain_record'"/>
                                    </group>
                                </form>
                            </field>
                        </page>

                        <page string="Import Plan" invisible="state != 'ready'">
                            <field name="import_plan" readonly="1" nolabel="1"/>
                        </page>
                    </notebook>

                    <footer>
                        <button name="action_validate" string="Validate File" type="object" class="btn-primary" invisible="state != 'upload'"/>
                        <button name="action_show_mappings" string="Resolve Mappings" type="object" class="btn-primary" invisible="state != 'summary' or overall_status != 'mapping_required'"/>
                        <button name="action_validate_again" string="Validate Again" type="object" class="btn-primary" invisible="state != 'mapping'"/>
                        <button name="action_back_to_summary" string="Back to Summary" type="object" class="btn-secondary" invisible="state != 'mapping'"/>
                        <button name="action_import_templates" string="Import Template" type="object" class="btn-primary" invisible="template_count != 1 or state not in ('ready', 'summary') or (state == 'summary' and overall_status != 'exact_duplicate')"/>
                        <button name="action_import_templates" string="Import Templates" type="object" class="btn-primary" invisible="template_count == 1 or state not in ('ready', 'summary') or (state == 'summary' and overall_status != 'exact_duplicate')"/>
                        <button name="action_open_imported_templates" string="Open Imported Template" type="object" class="btn-primary" invisible="state != 'imported' or template_count != 1 or imported_count == 0"/>
                        <button name="action_open_imported_templates" string="Open Existing Template" type="object" class="btn-primary" invisible="state != 'imported' or template_count != 1 or skipped_count == 0 or imported_count != 0"/>
                        <button name="action_open_imported_templates" string="Open Templates" type="object" class="btn-primary" invisible="state != 'imported' or template_count == 1"/>
                        <button string="Close" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_access_guard_import_wizard" model="ir.actions.act_window">
            <field name="name">Import Template</field>
            <field name="res_model">access.guard.import.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="view_access_guard_import_wizard_form"/>
            <field name="target">new</field>
            <field name="groups_id" eval="[(4, ref('npt_access_guard.group_access_guard_manager'))]"/>
        </record>

        <menuitem id="menu_access_guard_template"
                  name="Access Templates"
                  parent="menu_access_guard_root"
                  action="action_access_guard_template"
                  sequence="5"
                  groups="npt_access_guard.group_access_guard_manager"/>

        <menuitem id="menu_access_guard_import_template"
                  name="Import Template"
                  parent="menu_access_guard_root"
                  action="action_access_guard_import_wizard"
                  sequence="7"
                  groups="npt_access_guard.group_access_guard_manager"/>

        <record id="view_access_guard_apply_template_wizard_form" model="ir.ui.view">
            <field name="name">access.guard.apply.template.wizard.form</field>
            <field name="model">access.guard.apply.template.wizard</field>
            <field name="arch" type="xml">
                <form string="Apply Access Template">
                    <field name="state" invisible="1"/>
                    <field name="template_source_type" invisible="1"/>
                    <field name="validation_status" invisible="1"/>
                    <group invisible="state != 'configure'">
                        <field name="template_id" options="{'no_create': True}"/>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                    <group invisible="state != 'configure'">
                        <group>
                            <field name="user_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="apply_by_group"/>
                            <field name="group_ids" widget="many2many_tags" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="company_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="apply_without_company"/>
                            <field name="make_read_only"/>
                            <field name="copy_acl_lines"/>
                        </group>
                    </group>
                    <field name="preview_html" readonly="1" nolabel="1" invisible="state != 'preview'"/>
                    <footer>
                        <button name="action_preview_validate" string="Preview / Validate" type="object" class="btn-primary" invisible="state != 'configure'"/>
                        <button name="action_back_to_configure" string="Back" type="object" class="btn-secondary" invisible="state != 'preview'"/>
                        <button name="action_apply_template" string="Apply" type="object" class="btn-primary" invisible="state != 'preview' or validation_status != 'ready'"/>
                        <button string="Cancel" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_access_guard_apply_template_wizard" model="ir.actions.act_window">
            <field name="name">Apply Access Template</field>
            <field name="res_model">access.guard.apply.template.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <record id="view_access_guard_preview_wizard_form" model="ir.ui.view">
            <field name="name">access.guard.preview.wizard.form</field>
            <field name="model">access.guard.preview.wizard</field>
            <field name="arch" type="xml">
                <form string="Access Preview">
                    <group>
                        <field name="user_id" options="{'no_create': True}"/>
                        <field name="company_id" options="{'no_create': True}"/>
                        <field name="rule_ids" widget="many2many_tags" options="{'no_create': True}"/>
                    </group>
                    <notebook>
                        <page string="Preview">
                            <field name="preview_html" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Warnings">
                            <field name="conflict_html" readonly="1" nolabel="1"/>
                        </page>
                    </notebook>
                    <footer>
                        <button string="Close" special="cancel" class="btn-secondary"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_access_guard_preview_wizard" model="ir.actions.act_window">
            <field name="name">Access Preview</field>
            <field name="res_model">access.guard.preview.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem id="menu_access_guard_preview"
                  name="Access Preview"
                  parent="menu_access_guard_root"
                  action="action_access_guard_preview_wizard"
                  sequence="15"
                  groups="npt_access_guard.group_access_guard_manager"/>
    </data>
</odoo>
